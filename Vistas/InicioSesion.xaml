<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LogiApp.Vistas.InicioSesion"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="LogiApp - Acceso"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <Grid
            Grid.Row="0"
            Padding="20,15"
            BackgroundColor="White"
            ColumnDefinitions="60,*"
            VerticalOptions="Start">

            <Border
                Grid.Column="0"
                BackgroundColor="White"
                HeightRequest="40"
                HorizontalOptions="Start"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                WidthRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.1"
                        Radius="3"
                        Offset="0,2" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolverClicked" />
                </Border.GestureRecognizers>

                <Label
                    Margin="0,0,4,8"
                    FontAttributes="Bold"
                    FontSize="26"
                    HorizontalOptions="Center"
                    Text="&#x2039;"
                    TextColor="#0A0A33"
                    VerticalOptions="Center" />
            </Border>

            <Label
                Grid.Column="1"
                CharacterSpacing="0.5"
                FontAttributes="Bold"
                FontSize="16"
                HorizontalOptions="Start"
                Text="Acceso"
                TextColor="#0A0A33"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="30"
                Spacing="20"
                VerticalOptions="Center">

                <Image
                    Margin="0,0,0,15"
                    HeightRequest="120"
                    HorizontalOptions="Center"
                    Source="login.png" />

                <Label
                    FontAttributes="Bold"
                    FontSize="28"
                    HorizontalOptions="Center"
                    Text="Iniciar Sesión" />

                <Label
                    Margin="0,0,0,10"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="Ingresa tus credenciales para continuar"
                    TextColor="Gray" />

                <Frame
                    Padding="5,0"
                    BorderColor="#E0E0E0"
                    CornerRadius="10">
                    <Entry
                        x:Name="UsuarioEntry"
                        Keyboard="Text"
                        Placeholder="Usuario" />
                </Frame>

                <Frame
                    Padding="10,0"
                    BorderColor="#E0E0E0"
                    CornerRadius="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry
                            x:Name="ContrasenaEntry"
                            Grid.Column="0"
                            IsPassword="True"
                            Placeholder="Contraseña"
                            VerticalOptions="Center" />

                        <ImageButton
                            x:Name="TogglePasswordButton"
                            Grid.Column="1"
                            Margin="5,0"
                            BackgroundColor="Transparent"
                            Clicked="OnTogglePasswordClicked"
                            HeightRequest="25"
                            Source="ver.png"
                            VerticalOptions="Center"
                            WidthRequest="25" />
                    </Grid>
                </Frame>

                <Button
                    Margin="0,10,0,0"
                    BackgroundColor="#2196F3"
                    Clicked="OnLoginClicked"
                    CornerRadius="25"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    Text="INICIAR SESIÓN"
                    TextColor="White" />

                <ActivityIndicator
                    x:Name="CargandoIndicator"
                    IsRunning="False"
                    IsVisible="False"
                    Color="#2196F3" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>