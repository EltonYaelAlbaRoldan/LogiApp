<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LogiApp.Vistas.PaginaHistorial"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Historial"
    BackgroundColor="#F5F5F7"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid
            Grid.Row="0"
            Padding="20,15"
            BackgroundColor="White"
            ColumnDefinitions="60,*">

            <Border
                Grid.Column="0"
                BackgroundColor="White"
                HeightRequest="40"
                HorizontalOptions="Start"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                WidthRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolverClicked" />
                </Border.GestureRecognizers>
                <Label
                    Margin="0,0,4,8"
                    FontAttributes="Bold"
                    FontSize="26"
                    HorizontalOptions="Center"
                    Text="‹"
                    TextColor="#0A0A33"
                    VerticalOptions="Center" />
            </Border>

            <Label
                Grid.Column="1"
                CharacterSpacing="0.5"
                FontAttributes="Bold"
                FontSize="16"
                Text="HISTORIAL DE VIAJES"
                TextColor="#0A0A33"
                VerticalOptions="Center" />
        </Grid>

        <RefreshView
            x:Name="RefreshHistorial"
            Grid.Row="1"
            RefreshColor="#2196F3"
            Refreshing="OnRefreshRequested">
            <CollectionView x:Name="ListaViajes">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,20"
                            Padding="15"
                            BackgroundColor="White"
                            Stroke="#E8E8E8"
                            StrokeShape="RoundRectangle 12">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">

                                <VerticalStackLayout
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Spacing="2">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="{Binding Folio}"
                                        TextColor="#0A0A33" />
                                    <Label
                                        FontSize="13"
                                        Text="{Binding Unidad, StringFormat='Unidad: {0}'}"
                                        TextColor="Gray" />
                                    <Label
                                        FontSize="12"
                                        Text="{Binding Fecha, StringFormat='Fecha: {0}'}"
                                        TextColor="Gray" />
                                </VerticalStackLayout>

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="8,4"
                                    BackgroundColor="{Binding ColorEstado}"
                                    StrokeShape="RoundRectangle 6"
                                    VerticalOptions="Start">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="10"
                                        Text="{Binding Estado}"
                                        TextColor="White" />
                                </Border>

                                <Button
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,10,0,0"
                                    BackgroundColor="#F5F5F7"
                                    BorderColor="#2196F3"
                                    BorderWidth="1"
                                    Clicked="OnVerDetallesClicked"
                                    CommandParameter="{Binding .}"
                                    FontSize="12"
                                    HeightRequest="40"
                                    Text="VER DETALLES DEL VIAJE"
                                    TextColor="#2196F3" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Margin="0,50"
                        HorizontalOptions="Center"
                        Spacing="10"
                        VerticalOptions="Center">
                        <Label
                            HorizontalOptions="Center"
                            Text="No se encontraron viajes realizados."
                            TextColor="Gray" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>