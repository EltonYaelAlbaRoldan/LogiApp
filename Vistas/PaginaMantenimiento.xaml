<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LogiApp.Vistas.PaginaMantenimiento"
             Title="Mantenimiento"
             Shell.NavBarIsVisible="False" 
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F5F7">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="60,*" Padding="20,15" BackgroundColor="White">
            <Border Grid.Column="0" HeightRequest="40" WidthRequest="40" HorizontalOptions="Start" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolverClicked" />
                </Border.GestureRecognizers>
                <Label Text="‹" TextColor="#0A0A33" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,4,8" />
            </Border>
            <Label Grid.Column="1" Text="REPORTE DE MANTENIMIENTO" VerticalOptions="Center" FontAttributes="Bold" FontSize="16" TextColor="#0A0A33" CharacterSpacing="0.5"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18" Padding="25,20">

                <Label Text="Información del Servicio" FontSize="16" TextColor="Gray" FontAttributes="Bold" />

                <DatePicker x:Name="FechaMantenimientoPicker" Format="dd/MM/yyyy" MinimumDate="01/01/2024" />

                <Entry x:Name="OperadorEntry" Placeholder="Nombre del Operador" Visual="Material" />

                <Entry x:Name="PlacasEntry" Placeholder="Placas (Caja y/o Tráiler)" Visual="Material" />

                <BoxView HeightRequest="1" Color="#E0E0E0" />

                <Label Text="Ubicación del Servicio" FontSize="16" TextColor="Gray" FontAttributes="Bold" />

                <Entry x:Name="LugarEntry" Placeholder="Lugar de mantenimiento (Ciudad/Estado)" Visual="Material" />

                <Entry x:Name="EstablecimientoEntry" Placeholder="Nombre del Establecimiento/Taller" Visual="Material" />

                <BoxView HeightRequest="1" Color="#E0E0E0" />

                <Label Text="Detalles del Trabajo" FontSize="16" TextColor="Gray" FontAttributes="Bold" />

                <Editor x:Name="TipoMantenimientoEntry" Placeholder="Descripción del tipo de mantenimiento" AutoSize="TextChanges" MinimumHeightRequest="80" />

                <Editor x:Name="PiezasCambiadasEntry" Placeholder="Lista de piezas cambiadas" AutoSize="TextChanges" MinimumHeightRequest="80" />

                <Entry x:Name="KilometrajeEntry" Placeholder="Kilometraje Actual (Cambio de aceite)" Keyboard="Numeric" MaxLength="10" />

                <BoxView HeightRequest="1" Color="#E0E0E0" />

                <Label Text="Información Financiera" FontSize="16" TextColor="Gray" FontAttributes="Bold" />

                <Entry x:Name="CostoEntry" Placeholder="Costo Total ($)" Keyboard="Numeric" Visual="Material" />

                <Label Text="Checklist Rápido de Seguridad" FontSize="14" TextColor="Gray" Margin="0,10,0,0"/>
                <Border Padding="15" BackgroundColor="White" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10">
                            <CheckBox x:Name="CheckAceite" Color="#2196F3" />
                            <Label Text="Aceite / Anticongelante OK" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <CheckBox x:Name="CheckFrenos" Color="#2196F3" />
                            <Label Text="Frenos y Aire OK" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button Text="📷 Adjuntar Evidencia" 
                        BackgroundColor="#F8F8F8" 
                        TextColor="#0A0A33" 
                        BorderColor="#D0D0D0" 
                        BorderWidth="1" 
                        Margin="0,10,0,0"/>

                <Button x:Name="BtnGuardarMantenimiento" 
                        Text="GUARDAR REPORTE COMPLETO" 
                        BackgroundColor="#0A0A33" 
                        TextColor="White" 
                        HeightRequest="60" 
                        FontAttributes="Bold"
                        CornerRadius="12" 
                        Margin="0,10,0,30"
                        Clicked="OnGuardarMantenimientoClicked"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>