<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LogiApp.Vistas.PaginaMantenimiento"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mantenimiento"
    BackgroundColor="#F5F5F7"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <!--  Estructura de la página de reporte de mantenimiento  -->
    <Grid RowDefinitions="Auto,*">
        <!--  Encabezado  -->
        <Grid
            Grid.Row="0"
            Padding="20,15"
            BackgroundColor="White"
            ColumnDefinitions="60,*">
            <Border
                Grid.Column="0"
                BackgroundColor="White"
                HeightRequest="40"
                HorizontalOptions="Start"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                WidthRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolverClicked" />
                </Border.GestureRecognizers>
                <Label
                    Margin="0,0,4,8"
                    FontAttributes="Bold"
                    FontSize="26"
                    HorizontalOptions="Center"
                    Text="‹"
                    TextColor="#0A0A33"
                    VerticalOptions="Center" />
            </Border>
            <Label
                Grid.Column="1"
                CharacterSpacing="0.5"
                FontAttributes="Bold"
                FontSize="16"
                Text="REPORTE DE MANTENIMIENTO"
                TextColor="#0A0A33"
                VerticalOptions="Center" />
        </Grid>

        <!--  Formulario  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="25,20" Spacing="18">

                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Información del Servicio"
                    TextColor="Gray" />

                <Label
                    Margin="0,5,0,0"
                    FontSize="14"
                    Text="Operador Responsable"
                    TextColor="Gray" />
                <Frame
                    Padding="15,10"
                    BackgroundColor="#F0F0F0"
                    BorderColor="#E0E0E0"
                    CornerRadius="10">
                    <Label
                        x:Name="OperadorLabel"
                        FontAttributes="Bold"
                        Text="Cargando operador..."
                        TextColor="#0A0A33"
                        VerticalOptions="Center" />
                </Frame>

                <DatePicker
                    x:Name="FechaMantenimientoPicker"
                    Format="dd/MM/yyyy"
                    MinimumDate="01/01/2024" />

                <Grid>
                    <Picker
                        x:Name="UnidadPicker"
                        Title="Seleccione Unidad"
                        HorizontalOptions="FillAndExpand"
                        TitleColor="Gray"
                        Visual="Material" />

                    <ActivityIndicator
                        x:Name="CargandoUnidades"
                        Margin="0,0,10,0"
                        HeightRequest="20"
                        HorizontalOptions="End"
                        IsRunning="False"
                        Color="#2196F3" />
                </Grid>

                <BoxView HeightRequest="1" Color="#E0E0E0" />

                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Ubicación del Servicio"
                    TextColor="Gray" />

                <Entry
                    x:Name="LugarEntry"
                    Placeholder="Lugar de mantenimiento (Ciudad/Estado)"
                    Visual="Material" />

                <Entry
                    x:Name="EstablecimientoEntry"
                    Placeholder="Nombre del Establecimiento/Taller"
                    Visual="Material" />

                <BoxView HeightRequest="1" Color="#E0E0E0" />

                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Detalles del Trabajo"
                    TextColor="Gray" />

                <Editor
                    x:Name="TipoMantenimientoEntry"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="80"
                    Placeholder="Descripción del tipo de mantenimiento" />

                <Editor
                    x:Name="PiezasCambiadasEntry"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="80"
                    Placeholder="Lista de piezas cambiadas" />

                <Entry
                    x:Name="KilometrajeEntry"
                    Keyboard="Numeric"
                    MaxLength="10"
                    Placeholder="Kilometraje Actual (Cambio de aceite)" />

                <BoxView HeightRequest="1" Color="#E0E0E0" />

                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Información Financiera"
                    TextColor="Gray" />

                <Entry
                    x:Name="CostoEntry"
                    Keyboard="Numeric"
                    Placeholder="Costo Total ($)"
                    Visual="Material" />

                <Label
                    Margin="0,10,0,0"
                    FontSize="14"
                    Text="Checklist Rápido de Seguridad"
                    TextColor="Gray" />
                <Border
                    Padding="15"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="10">
                            <CheckBox x:Name="CheckAceite" Color="#2196F3" />
                            <Label Text="Aceite / Anticongelante OK" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <CheckBox x:Name="CheckFrenos" Color="#2196F3" />
                            <Label Text="Frenos y Aire OK" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button
                    Margin="0,10,0,0"
                    BackgroundColor="#F8F8F8"
                    BorderColor="#D0D0D0"
                    BorderWidth="1"
                    Text="📷 Adjuntar Evidencia"
                    TextColor="#0A0A33" />

                <!--  Botón de envío  -->
                <Button
                    x:Name="BtnGuardarMantenimiento"
                    Margin="0,10,0,30"
                    BackgroundColor="#0A0A33"
                    Clicked="OnGuardarMantenimientoClicked"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    HeightRequest="60"
                    Text="GUARDAR REPORTE COMPLETO"
                    TextColor="White" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>