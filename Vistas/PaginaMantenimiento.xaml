<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LogiApp.Vistas.PaginaMantenimiento"
             Title="Mantenimiento"
             Shell.NavBarIsVisible="False" 
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="60,*" Padding="20,15" BackgroundColor="White">
            <Border Grid.Column="0" HeightRequest="40" WidthRequest="40" HorizontalOptions="Start" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolverClicked" />
                </Border.GestureRecognizers>
                <Label Text="‹" TextColor="#0A0A33" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,4,8" />
            </Border>
            <Label Grid.Column="1" Text="INSPECCIÓN DE UNIDAD" VerticalOptions="Center" FontAttributes="Bold" FontSize="16" TextColor="#0A0A33" CharacterSpacing="0.5"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="22" Padding="25,20">

                <Label Text="Datos del Vehículo" FontSize="18" TextColor="#606060" FontAttributes="Bold" />

                <Entry x:Name="EconomicoEntry" Placeholder="Número Económico (Ej: T-105)" Visual="Material" />
                <Entry x:Name="KilometrajeEntry" Placeholder="Kilometraje Actual" Keyboard="Numeric" MaxLength="7" />

                <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,5" />

                <Label Text="Checklist de Seguridad (KPI)" FontSize="18" TextColor="#606060" FontAttributes="Bold" />

                <Border Padding="20" BackgroundColor="White" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.05" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        <HorizontalStackLayout Spacing="12">
                            <CheckBox x:Name="CheckAceite" Color="#2196F3" />
                            <Label Text="Nivel de Aceite / Anticongelante" VerticalOptions="Center" FontSize="15" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="12">
                            <CheckBox x:Name="CheckFrenos" Color="#2196F3" />
                            <Label Text="Sistema de Frenos y Aire" VerticalOptions="Center" FontSize="15" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="12">
                            <CheckBox x:Name="CheckLuces" Color="#2196F3" />
                            <Label Text="Luces y Señalización" VerticalOptions="Center" FontSize="15" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="12">
                            <CheckBox x:Name="CheckLlantas" Color="#2196F3" />
                            <Label Text="Presión y Estado de Neumáticos" VerticalOptions="Center" FontSize="15" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Evidencia Fotográfica" FontSize="18" TextColor="#606060" FontAttributes="Bold" />

                <Button Text="📷 Capturar Estado de Unidad" 
                        BackgroundColor="#F8F8F8" 
                        TextColor="#0A0A33" 
                        BorderColor="#D0D0D0" 
                        BorderWidth="1" 
                        HeightRequest="50"
                        CornerRadius="8" />

                <Button x:Name="BtnGuardarMantenimiento" 
                        Text="FINALIZAR REPORTE" 
                        BackgroundColor="#0A0A33" 
                        TextColor="White" 
                        HeightRequest="60" 
                        FontAttributes="Bold"
                        CornerRadius="12" 
                        Margin="0,15,0,25"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>