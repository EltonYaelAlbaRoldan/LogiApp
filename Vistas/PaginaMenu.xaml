<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LogiApp.Vistas.PaginaMenu"
             Title=" ">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">

            <Image Source="welcome.png" 
                   HeightRequest="150" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,20"/>

            <Label Text="Seleccione una opción" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

            <Button Text="GESTIÓN DE VIAJES"
                    HeightRequest="80"
                    FontSize="18"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    CornerRadius="15"
                    Clicked="OnViajesClicked" />

            <Button Text="MANTENIMIENTO"
                    HeightRequest="80"
                    FontSize="18"
                    BackgroundColor="#FF9800"
                    TextColor="White"
                    CornerRadius="15"
                    Clicked="OnMantenimientoClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>