<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LogiApp.Vistas.PaginaPerfil"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mi Perfil"
    BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">
            <Label
                x:Name="LblNombre"
                FontAttributes="Bold"
                FontSize="22"
                HorizontalOptions="Center" />
            <Label
                x:Name="LblId"
                Margin="0,0,0,10"
                FontSize="14"
                HorizontalOptions="Center"
                TextColor="Gray" />

            <Frame
                x:Name="FrameLicencia"
                CornerRadius="10"
                HasShadow="False">
                <HorizontalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" Text="📅 Licencia:" />
                    <Label x:Name="LblVigenciaLicencia" Text="--/--/----" />
                </HorizontalStackLayout>
            </Frame>

            <Frame
                x:Name="FrameMedico"
                CornerRadius="10"
                HasShadow="False">
                <HorizontalStackLayout Spacing="10">
                    <Label FontAttributes="Bold" Text="🏥 Médico:" />
                    <Label x:Name="LblVigenciaMedico" Text="--/--/----" />
                </HorizontalStackLayout>
            </Frame>

            <BoxView
                Margin="0,10"
                HeightRequest="1"
                Color="#EEE" />

            <Label
                FontAttributes="Bold"
                FontSize="18"
                Text="Seguridad" />
            <Entry
                x:Name="NuevaPassEntry"
                IsPassword="True"
                Placeholder="Nueva Contraseña" />
            <Button
                BackgroundColor="#2196F3"
                Clicked="OnCambiarPassClicked"
                Text="ACTUALIZAR CONTRASEÑA"
                TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>