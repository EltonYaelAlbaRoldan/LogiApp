<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LogiApp.Vistas.PaginaRegistro"
             Title="Registro de Operador">

    <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
        <Label Text="Nuevo Registro" FontSize="24" HorizontalOptions="Center" />

        <Entry x:Name="NombreEntry" 
               Placeholder="Nombre del Operador" />

        <Entry x:Name="EdadEntry" 
               Placeholder="Edad"
               Keyboard="Numeric" 
               MaxLength="2"/>

        <Button Text="Registrar" 
                Clicked="OnProbarRegistroClicked" 
                IsEnabled="{Binding IsNotBusy, Source={x:Reference this}}" />
        <ActivityIndicator IsRunning="{Binding IsBusy, Source={x:Reference this}}"
                           IsVisible="{Binding IsBusy, Source={x:Reference this}}"
                           Color="#2196F3"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           WidthRequest="50"
                           HeightRequest="50" />
    </VerticalStackLayout>
</ContentPage>