<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LogiApp.Vistas.PaginaRegistro"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="this"
    Title="LogiApp - Registro"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <Grid
            Grid.Row="0"
            Padding="20,15"
            BackgroundColor="White"
            ColumnDefinitions="60,*"
            VerticalOptions="Center">
            <!--  Encabezado con botón de volver y título !  -->
            <Border
                x:Name="BtnVolver"
                Grid.Column="0"
                BackgroundColor="White"
                HeightRequest="40"
                HorizontalOptions="Start"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                WidthRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.1"
                        Radius="3"
                        Offset="0,2" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolverClicked" />
                </Border.GestureRecognizers>

                <Label
                    Margin="0,0,4,8"
                    FontAttributes="Bold"
                    FontSize="26"
                    HorizontalOptions="Center"
                    Text="&#x2039;"
                    TextColor="#0A0A33"
                    VerticalOptions="Center" />
            </Border>

            <!--  Título de la página !  -->
            <Label
                Grid.Column="1"
                CharacterSpacing="0.5"
                FontAttributes="Bold"
                FontSize="16"
                HorizontalOptions="Start"
                Text="REGISTRO DE OPERADOR"
                TextColor="#0A0A33"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="25,10,25,30" Spacing="18">

                <!--  Formulario de registro de operador !  -->
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Información Personal"
                    TextColor="Gray" />

                <!--  Entradas de texto para los datos del operador !  -->
                <Entry
                    x:Name="NombreEntry"
                    Placeholder="Nombre Completo"
                    Visual="Material" />
                <Entry
                    x:Name="EdadEntry"
                    Keyboard="Numeric"
                    MaxLength="2"
                    Placeholder="Edad" />
                <Entry
                    x:Name="CorreoEntry"
                    Keyboard="Email"
                    Placeholder="Correo Electrónico" />
                <Entry
                    x:Name="Tel1Entry"
                    Keyboard="Numeric"
                    MaxLength="10"
                    Placeholder="No. de teléfono 1" />
                <Entry
                    x:Name="Tel2Entry"
                    Keyboard="Numeric"
                    MaxLength="10"
                    Placeholder="No. de teléfono 2" />
                <Entry
                    x:Name="ClaveInterbancariaEntry"
                    Keyboard="Numeric"
                    MaxLength="18"
                    Placeholder="Clave Interbancaria" />
                <Entry
                    x:Name="NumLicenciaEntry"
                    MaxLength="15"
                    Placeholder="Número de Licencia Federal"
                    Visual="Material" />
                <!--  Entrada de contraseña con opción para mostrar/ocultar !  -->
                <Frame
                    Padding="10,0"
                    BorderColor="#E0E0E0"
                    CornerRadius="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry
                            x:Name="ContrasenaOperadorEntry"
                            Grid.Column="0"
                            IsPassword="True"
                            Placeholder="Asignar Contraseña al Operador"
                            VerticalOptions="Center" />
                        <Label
                            x:Name="TogglePasswordLabel"
                            Grid.Column="1"
                            Padding="10"
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="VER"
                            TextColor="#2196F3"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTogglePasswordClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Frame>
                <!--  Sección de vigencias y fechas !  -->
                <BoxView HeightRequest="1" Color="#EEEEEE" />
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Vigencias y Fechas"
                    TextColor="Gray" />
                <VerticalStackLayout Spacing="5">
                    <Label
                        Margin="5,0"
                        FontSize="12"
                        Text="Vigencia de licencia federal" />
                    <DatePicker x:Name="VigenciaLicenciaPicker" Format="dd/MM/yyyy" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="5">
                    <Label
                        Margin="5,0"
                        FontSize="12"
                        Text="Vigencia de apto médico" />
                    <DatePicker x:Name="VigenciaMedicoPicker" Format="dd/MM/yyyy" />
                </VerticalStackLayout>
                <!--  Sección de subida de datos !  -->
                <Button
                    x:Name="BtnRegistrarDatos"
                    Margin="0,15,0,0"
                    BackgroundColor="#0A0A33"
                    Clicked="OnProbarRegistroClicked"
                    CornerRadius="10"
                    HeightRequest="55"
                    IsEnabled="{Binding IsNotBusy, Source={x:Reference this}}"
                    Text="1. REGISTRAR DATOS Y CARPETA"
                    TextColor="White" />


                <!--  Sección de subida de archivos PDF !  -->
                <BoxView HeightRequest="1" Color="#EEEEEE" />
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Expediente Digital (Subir PDF)"
                    TextColor="Gray" />
                <Button
                    BackgroundColor="#F5F5F5"
                    BorderColor="#E0E0E0"
                    BorderWidth="1"
                    Clicked="OnSubirDomicilioClicked"
                    Text="Comprobante de Domicilio"
                    TextColor="#0A0A33" />
                <Button
                    BackgroundColor="#F5F5F5"
                    BorderColor="#E0E0E0"
                    BorderWidth="1"
                    Clicked="OnSubirRfcClicked"
                    Text="RFC"
                    TextColor="#0A0A33" />
                <Button
                    BackgroundColor="#F5F5F5"
                    BorderColor="#E0E0E0"
                    BorderWidth="1"
                    Clicked="OnSubirCurpClicked"
                    Text="CURP"
                    TextColor="#0A0A33" />
                <Button
                    BackgroundColor="#F5F5F5"
                    BorderColor="#E0E0E0"
                    BorderWidth="1"
                    Clicked="OnSubirLicenciaFederalClicked"
                    Text="Licencia Federal (PDF)"
                    TextColor="#0A0A33" />
                <Button
                    BackgroundColor="#F5F5F5"
                    Clicked="OnSubirIneClicked"
                    Text="INE"
                    TextColor="#0A0A33" />
                <Button
                    BackgroundColor="#F5F5F5"
                    Clicked="OnSubirActaClicked"
                    Text="Acta de Nacimiento"
                    TextColor="#0A0A33" />
                <Button
                    BackgroundColor="#F5F5F5"
                    Clicked="OnSubirNssClicked"
                    Text="NSS"
                    TextColor="#0A0A33" />
                <Button
                    BackgroundColor="#F5F5F5"
                    Clicked="OnSubirCvClicked"
                    Text="CV"
                    TextColor="#0A0A33" />
                <Button
                    BackgroundColor="#F5F5F5"
                    BorderColor="#E0E0E0"
                    BorderWidth="1"
                    Clicked="OnSubirMedicoClicked"
                    Text="Apto Médico (PDF)"
                    TextColor="#0A0A33" />
                <!--  Botón para subir todos los archivos PDF !  -->
                <Button
                    x:Name="BtnSubirArchivos"
                    Margin="0,15,0,0"
                    BackgroundColor="#0A0A33"
                    Clicked="OnSubirArchivosClicked"
                    CornerRadius="10"
                    HeightRequest="55"
                    IsEnabled="{Binding IsNotBusy, Source={x:Reference this}}"
                    Text="2. SUBIR ARCHIVOS PDF"
                    TextColor="White" />

                <!--  Indicador de actividad mientras se procesan las acciones !  -->
                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsBusy, Source={x:Reference this}}"
                    IsVisible="{Binding IsBusy, Source={x:Reference this}}"
                    Color="#2196F3" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>