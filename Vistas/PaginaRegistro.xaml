<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LogiApp.Vistas.PaginaRegistro"
             x:Name="this"
             Title="LogiApp - Registro"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" 
              ColumnDefinitions="60,*" 
              Padding="20,15" 
              BackgroundColor="White"
              VerticalOptions="Center">

            <Border Grid.Column="0"
                    HeightRequest="40"
                    WidthRequest="40"
                    HorizontalOptions="Start"
                    BackgroundColor="White"
                    Stroke="#E0E0E0"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="3" Opacity="0.1" />
                </Border.Shadow>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolverClicked" />
                </Border.GestureRecognizers>

                <Label Text="&#x2039;" 
                       TextColor="#0A0A33" 
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"
                       Margin="0,0,4,8" />
            </Border>

            <Label Grid.Column="1"
                   Text="REGISTRO DE OPERADOR" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Start"
                   FontAttributes="Bold" 
                   FontSize="16"
                   TextColor="#0A0A33" 
                   CharacterSpacing="0.5"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18" Padding="25,10,25,30">

                <Label Text="Información Personal" FontSize="18" TextColor="Gray" FontAttributes="Bold" />

                <Entry x:Name="NombreEntry" Placeholder="Nombre Completo" Visual="Material" />
                <Entry x:Name="EdadEntry" Placeholder="Edad" Keyboard="Numeric" MaxLength="2" />
                <Entry x:Name="CorreoEntry" Placeholder="Correo Electrónico" Keyboard="Email" />
                <Entry x:Name="Tel1Entry" Placeholder="No. de teléfono 1" Keyboard="Telephone" />
                <Entry x:Name="Tel2Entry" Placeholder="No. de teléfono 2" Keyboard="Telephone" />

                <BoxView HeightRequest="1" Color="#EEEEEE" />
                <Label Text="Documentación Federal" FontSize="18" TextColor="Gray" FontAttributes="Bold" />

                <Entry x:Name="LicenciaEntry" Placeholder="No. de licencia federal" />

                <VerticalStackLayout Spacing="5">
                    <Label Text="Vigencia de licencia federal" FontSize="12" Margin="5,0"/>
                    <DatePicker x:Name="VigenciaLicenciaPicker" Format="dd/MM/yyyy" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Vigencia de apto medico" FontSize="12" Margin="5,0"/>
                    <DatePicker x:Name="VigenciaMedicoPicker" Format="dd/MM/yyyy" />
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#EEEEEE" />
                <Label Text="Datos Fiscales e Identificación" FontSize="18" TextColor="Gray" FontAttributes="Bold" />

                <Entry x:Name="DomicilioEntry" Placeholder="Domicilio" />
                <Entry x:Name="RfcEntry" Placeholder="RFC" CharacterSpacing="2" />
                <Entry x:Name="CurpEntry" Placeholder="CURP" CharacterSpacing="2" />

                <Button Text="GUARDAR REGISTRO" 
                        Clicked="OnProbarRegistroClicked"
                        IsEnabled="{Binding IsNotBusy, Source={x:Reference this}}"
                        BackgroundColor="#0A0A33"
                        TextColor="White"
                        HeightRequest="55"
                        CornerRadius="10"
                        Margin="0,15,0,0" />

                <ActivityIndicator IsRunning="{Binding IsBusy, Source={x:Reference this}}"
                                   IsVisible="{Binding IsBusy, Source={x:Reference this}}"
                                   Color="#2196F3"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>