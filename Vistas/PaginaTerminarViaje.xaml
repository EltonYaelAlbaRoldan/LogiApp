<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LogiApp.Vistas.PaginaTerminarViaje"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Finalizar Viaje">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">
            <Frame x:Name="PanelMonitoreo" BackgroundColor="#1E293B" CornerRadius="12" Padding="18" BorderColor="Transparent" HasShadow="True">
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">

                    <!-- Indicador de Red (Esto se queda igual) -->
                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8" Margin="0,0,0,10">
                        <BoxView x:Name="IndicadorRed" Color="#10B981" WidthRequest="10" HeightRequest="10" CornerRadius="5" VerticalOptions="Center"/>
                        <Label x:Name="LblEstadoRed" Text="Conectado (GPS Sincronizando)" TextColor="#94A3B8" FontSize="12" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Datos del Viaje -->
                    <!-- Asegúrate de que los Labels tengan nombre -->
                    <Label x:Name="LblFolio" Grid.Row="1" Grid.Column="0" Text="Folio: Cargando..." TextColor="White" FontAttributes="Bold" FontSize="18"/>
                    <Label x:Name="LblDestino" Grid.Row="2" Grid.Column="0" Text="Destino: ---" TextColor="#CBD5E1" FontSize="14" Margin="0,2,0,0"/>

                    <!-- Cronómetro en Vivo -->
                    <VerticalStackLayout Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End">
                        <!-- Le agregamos x:Name="LblTituloTiempo" -->
                        <Label x:Name="LblTituloTiempo" Text="TIEMPO EN RUTA" TextColor="#94A3B8" FontSize="10" HorizontalOptions="Center" FontAttributes="Bold"/>
                        <Label x:Name="LblCronometro" Text="00:00" TextColor="#38BDF8" FontAttributes="Bold" FontSize="32" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                </Grid>
            </Frame>

            <Label
                Margin="0,10,0,0"
                FontAttributes="Bold"
                Text="Monitoreo en Ruta" />
            <Button
                x:Name="BtnReportar"
                BackgroundColor="#4CAF50"
                Clicked="OnReportarUbicacionClicked"
                CornerRadius="8"
                Text="REPORTAR UBICACIÓN ACTUAL"
                TextColor="White" />
            <Label
                x:Name="LblUltimaActualizacion"
                FontSize="12"
                HorizontalOptions="Center"
                Text="Último reporte: Pendiente" />

            <BoxView
                Margin="0,10"
                HeightRequest="1"
                Color="#E0E0E0" />

            <Button
                x:Name="BtnArribo"
                BackgroundColor="#FF9800"
                Clicked="OnMarcarLlegadaClicked"
                CornerRadius="12"
                HeightRequest="50"
                Text="📍 MARCAR LLEGADA A DESTINO"
                TextColor="White" />

            <VerticalStackLayout
                x:Name="SeccionCierre"
                IsEnabled="False"
                Opacity="0.5"
                Spacing="15">
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Datos de Cierre y Evidencias" />

                <Label Text="Kilometraje de Llegada:" />
                <Entry
                    x:Name="KmLlegadaEntry"
                    Keyboard="Numeric"
                    Placeholder="000000" />

                <Label Text="Combustible de Llegada:" />
                <Entry
                    x:Name="CombustibleLlegadaEntry"
                    Keyboard="Numeric"
                    Placeholder="Litros en tanque al llegar" />

                <!-- SECCIÓN DE RECARGA DE COMBUSTIBLE EN RUTA -->
                <HorizontalStackLayout Spacing="10">
                    <Switch x:Name="SwitchRecarga" Toggled="OnSwitchRecargaToggled" />
                    <Label
                        Text="¿Cargaste gasolina/diésel en el viaje?"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <VerticalStackLayout
                    x:Name="SeccionRecarga"
                    IsVisible="False"
                    Spacing="5">
                    <Label Text="Combustible Recargado (Litros):" TextColor="#2196F3" />
                    <Entry
                        x:Name="CombustibleRecargaEntry"
                        Keyboard="Numeric"
                        Placeholder="Litros cargados"
                        Text="0" />
                </VerticalStackLayout>

                <Label Text="Observaciones:" />
                <Editor
                    x:Name="ObservacionesEditor"
                    HeightRequest="80"
                    Placeholder="Notas de entrega..." />

                <Button
                    BackgroundColor="Gray"
                    Clicked="OnTomarFotoClicked"
                    Text="📷 Agregar Foto de Evidencia"
                    TextColor="White" />

                <Label
                    x:Name="LblCantidadFotos"
                    HorizontalOptions="Center"
                    Text="0 fotos agregadas"
                    TextColor="Gray" />

                <CollectionView
                    x:Name="ListaFotos"
                    HeightRequest="170"
                    ItemsLayout="HorizontalList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Margin="4" WidthRequest="130">
                                <Image
                                    Aspect="AspectFill"
                                    HeightRequest="120"
                                    Source="{Binding .}"
                                    WidthRequest="130" />
                                <Button
                                    BackgroundColor="#F44336"
                                    Clicked="OnEliminarFotoClicked"
                                    CommandParameter="{Binding .}"
                                    FontSize="12"
                                    HeightRequest="36"
                                    Text="Eliminar"
                                    TextColor="White" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button
                    x:Name="BtnFinalizar"
                    BackgroundColor="#F44336"
                    Clicked="OnTerminarViajeClicked"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    HeightRequest="60"
                    Text="CONFIRMAR CIERRE DE VIAJE"
                    TextColor="White" />
            </VerticalStackLayout>

            <ActivityIndicator
                x:Name="IndicadorCarga"
                IsRunning="False"
                IsVisible="False"
                Color="#2196F3" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>