<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LogiApp.Vistas.PaginaViajes"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Gestión de Viajes"
    BackgroundColor="#F5F5F7"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid
            Grid.Row="0"
            Padding="20,15"
            BackgroundColor="White"
            ColumnDefinitions="60,*">
            <Border
                Grid.Column="0"
                BackgroundColor="White"
                HeightRequest="40"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                WidthRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolverClicked" />
                </Border.GestureRecognizers>
                <Label
                    Margin="0,0,4,8"
                    FontAttributes="Bold"
                    FontSize="26"
                    HorizontalOptions="Center"
                    Text="‹"
                    TextColor="#0A0A33"
                    VerticalOptions="Center" />
            </Border>
            <Label
                Grid.Column="1"
                CharacterSpacing="0.5"
                FontAttributes="Bold"
                FontSize="16"
                Text="REGISTRO DE VIAJE"
                TextColor="#0A0A33"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="25,20" Spacing="18">
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Detalles de la Ruta"
                    TextColor="#606060" />

                <Picker x:Name="OrigenPicker" Title="Ciudad de Origen" />
                <Picker x:Name="DestinoPicker" Title="Ciudad de Destino" />
                <Entry x:Name="ClienteEntry" Placeholder="Nombre del Cliente" />

                <BoxView
                    Margin="0,10"
                    HeightRequest="1"
                    Color="#E0E0E0" />

                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Datos del Vehículo"
                    TextColor="#606060" />

                <Grid ColumnDefinitions="*, Auto">
                    <Picker
                        x:Name="UnidadPicker"
                        Title="Selecciona Unidad"
                        Grid.Column="0" />
                    <ActivityIndicator
                        x:Name="CargandoUnidades"
                        Grid.Column="1"
                        HeightRequest="25"
                        WidthRequest="25"
                        Color="#2196F3" />
                </Grid>

                <Entry
                    x:Name="KmSalidaEntry"
                    Keyboard="Numeric"
                    Placeholder="Kilometraje de Salida" />

                <Entry
                    x:Name="CombustibleEntry"
                    Keyboard="Numeric"
                    Placeholder="Nivel de Combustible (Lts o %)" />

                <Button
                    x:Name="BtnGuardarViaje"
                    Margin="0,20"
                    BackgroundColor="#2196F3"
                    Clicked="OnGuardarViajeClicked"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    HeightRequest="60"
                    Text="INICIAR VIAJE"
                    TextColor="White" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>