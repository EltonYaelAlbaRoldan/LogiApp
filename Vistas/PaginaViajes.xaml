<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LogiApp.Vistas.PaginaViajes"
             Title="Gestión de Viajes"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F5F7">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="60,*" Padding="20,15" BackgroundColor="White">
            <Border Grid.Column="0" HeightRequest="40" WidthRequest="40" BackgroundColor="White" Stroke="#E0E0E0" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolverClicked" />
                </Border.GestureRecognizers>
                <Label Text="‹" TextColor="#0A0A33" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,4,8" />
            </Border>
            <Label Grid.Column="1" Text="REGISTRO DE VIAJE" VerticalOptions="Center" FontAttributes="Bold" FontSize="16" TextColor="#0A0A33" CharacterSpacing="0.5"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18" Padding="25,20">
                <Label Text="Detalles de la Ruta" FontSize="18" TextColor="#606060" FontAttributes="Bold" />

                <Entry x:Name="OrigenEntry" Placeholder="Ciudad de Origen" />
                <Entry x:Name="DestinoEntry" Placeholder="Ciudad de Destino" />
                <Entry x:Name="ClienteEntry" Placeholder="Nombre del Cliente" />

                <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,10" />

                <Label Text="Datos del Vehículo" FontSize="18" TextColor="#606060" FontAttributes="Bold" />
                <Entry x:Name="UnidadEntry" Placeholder="Número Económico de Unidad" />
                <Entry x:Name="KmSalidaEntry" Placeholder="Kilometraje de Salida" Keyboard="Numeric" />

                <Button x:Name="BtnGuardarViaje" 
                        Text="INICIAR VIAJE" 
                        BackgroundColor="#2196F3" 
                        TextColor="White" 
                        HeightRequest="60" 
                        FontAttributes="Bold"
                        CornerRadius="12" 
                        Margin="0,20"
                        Clicked="OnGuardarViajeClicked" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>